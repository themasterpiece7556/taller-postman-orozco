      "name": "New Request",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Prueba 1: Verificar el tiempo de respuesta (SLA de rendimiento)\r",
              "pm.test(\"El tiempo de respuesta es menor a 500 ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(500);\r",
              "});\r",
              "\r",
              "// Prueba 2: Verificar la presencia y el tipo de dato de campos clave\r",
              "pm.test(\"El objeto contiene el campo 'title' de tipo String\", function () {\r",
              "    const responseData = pm.response.json();\r",
              "    \r",
              "    // Si la respuesta es un arreglo (ej. GET /posts), tomamos el primer elemento\r",
              "    const post = Array.isArray(responseData) ? responseData[0] : responseData;\r",
              "    \r",
              "    pm.expect(post).to.have.property('title');\r",
              "    pm.expect(post.title).to.be.a('string');\r",
              "});\r",
              "\r",
              "// Prueba 3: Verificar la cantidad de elementos en una lista (Array length)\r",
              "pm.test(\"La respuesta contiene exactamente 100 publicaciones\", function () {\r",
              "    const responseData = pm.response.json();\r",
              "    \r",
              "    // Verificamos que sea un arreglo y que su longitud sea 100\r",
              "    pm.expect(responseData).to.be.an('array');\r",
              "    pm.expect(responseData.length).to.eql(100);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
